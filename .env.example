# Supabase Configuration
# Get these values from your Supabase project dashboard
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic API key (server-side only — never prefix with PUBLIC_)
# Used for AI categorisation of imported bank transactions
ANTHROPIC_API_KEY=sk-ant-...
# Only needed when the key is an organisation-level key (not created inside a workspace)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
